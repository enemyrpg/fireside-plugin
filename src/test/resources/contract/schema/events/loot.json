{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event: loot",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "accountHash": {
      "type": "string",
      "pattern": "^-?\\d+$",
      "not": {
        "const": "-1"
      }
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "sessionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "type": {
      "type": "string",
      "const": "loot"
    },
    "payload": {
      "type": "object",
      "properties": {
        "source": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "NPC"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "npcId": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "combatLevel": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "type",
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "PLAYER"
                },
                "name": {
                  "type": "null"
                }
              },
              "required": [
                "type",
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "EVENT",
                    "CLUE",
                    "OTHER"
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "name"
              ],
              "additionalProperties": false
            }
          ]
        },
        "items": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "itemId": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "quantity": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "gePrice": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "haPrice": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "itemId",
              "name",
              "quantity",
              "gePrice",
              "haPrice"
            ],
            "additionalProperties": false
          }
        },
        "killCount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "source",
        "items"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "schemaVersion",
    "accountHash",
    "occurredAt",
    "sessionId",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
