{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event: bank.snapshot",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "accountHash": {
      "type": "string",
      "pattern": "^-?\\d+$",
      "not": {
        "const": "-1"
      }
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "sessionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "type": {
      "type": "string",
      "const": "bank.snapshot"
    },
    "payload": {
      "type": "object",
      "properties": {
        "tabSizes": {
          "minItems": 9,
          "maxItems": 9,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "items": {
          "maxItems": 2000,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "itemId": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "quantity": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "placeholder": {
                    "type": "boolean",
                    "const": false
                  },
                  "gePrice": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "haPrice": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "itemId",
                  "name",
                  "quantity",
                  "placeholder",
                  "gePrice",
                  "haPrice"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "itemId": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "quantity": {
                    "type": "number",
                    "const": 0
                  },
                  "placeholder": {
                    "type": "boolean",
                    "const": true
                  },
                  "gePrice": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "haPrice": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "itemId",
                  "name",
                  "quantity",
                  "placeholder",
                  "gePrice",
                  "haPrice"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "inventory": {
          "maxItems": 28,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "itemId": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "quantity": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "gePrice": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "haPrice": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "itemId",
              "name",
              "quantity",
              "gePrice",
              "haPrice"
            ],
            "additionalProperties": false
          }
        },
        "equipment": {
          "maxItems": 14,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "itemId": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "quantity": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "gePrice": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "haPrice": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "slot",
              "itemId",
              "name",
              "quantity",
              "gePrice",
              "haPrice"
            ],
            "additionalProperties": false
          }
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "tabSizes",
        "items",
        "inventory",
        "equipment",
        "contentHash"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "schemaVersion",
    "accountHash",
    "occurredAt",
