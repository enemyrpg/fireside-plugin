{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event: diaries.snapshot",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "accountHash": {
      "type": "string",
      "pattern": "^-?\\d+$",
      "not": {
        "const": "-1"
      }
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "sessionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "type": {
      "type": "string",
      "const": "diaries.snapshot"
    },
    "payload": {
      "type": "object",
      "properties": {
        "diaries": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "region": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "tier": {
                "type": "string",
                "enum": [
                  "EASY",
                  "MEDIUM",
                  "HARD",
                  "ELITE"
                ]
              },
              "completed": {
                "type": "boolean"
              }
            },
            "required": [
              "region",
              "tier",
              "completed"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "diaries"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "schemaVersion",
    "accountHash",
    "occurredAt",
    "sessionId",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
