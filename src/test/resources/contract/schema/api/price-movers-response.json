                      "maximum": 9007199254740991
                    },
                    "change": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "quantity": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "kind",
                    "itemId",
                    "name",
                    "priceEach",
                    "previousPriceEach",
                    "change",
                    "quantity"
                  ],
