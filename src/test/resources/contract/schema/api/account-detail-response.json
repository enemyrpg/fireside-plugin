      "maximum": 9007199254740991
    },
    "displayName": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "accountType": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "NORMAL",
            "IRONMAN",
            "ULTIMATE_IRONMAN",
            "HARDCORE_IRONMAN",
            "GROUP_IRONMAN",
            "HARDCORE_GROUP_IRONMAN",
            "UNRANKED_GROUP_IRONMAN"
