{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API: ingest-icons-wanted-request",
  "type": "object",
  "properties": {
    "itemIds": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "skills": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100,
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "bosses": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100,
        "pattern": "^\\S(?:.*\\S)?$"
      }
    }
  },
  "additionalProperties": false
}
