{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API: create-invite-request",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "maxLength": 1000
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "member"
      ]
    },
    "canCreateApiKeys": {
      "type": "boolean"
    },
    "days": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 7
        },
        {
          "type": "number",
          "const": 30
        }
      ]
    }
  },
  "required": [
    "role",
    "canCreateApiKeys"
  ],
  "additionalProperties": false
}
