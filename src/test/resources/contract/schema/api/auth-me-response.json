{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API: auth-me-response",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "local",
        "login"
      ]
    },
    "user": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "username": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "enum": [
                "admin",
                "member"
              ]
            },
            "canCreateApiKeys": {
              "type": "boolean"
            },
            "twoFactorEnabled": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "username",
            "role",
            "canCreateApiKeys",
            "twoFactorEnabled"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "mode",
    "user"
  ],
  "additionalProperties": false
}
