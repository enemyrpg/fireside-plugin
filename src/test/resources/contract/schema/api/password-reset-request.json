{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API: password-reset-request",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "maxLength": 256
    },
    "password": {
      "type": "string",
      "maxLength": 1024
    },
    "code": {
      "type": "string",
      "maxLength": 64
    }
  },
  "required": [
    "token",
    "password"
  ],
  "additionalProperties": false
}
