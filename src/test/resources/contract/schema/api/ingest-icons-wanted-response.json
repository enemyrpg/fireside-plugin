{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API: ingest-icons-wanted-response",
  "type": "object",
  "properties": {
    "missing": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "missingSkills": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100,
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "missingBosses": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100,
        "pattern": "^\\S(?:.*\\S)?$"
      }
    }
  },
  "required": [
    "missing"
  ],
  "additionalProperties": false
}
