{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API: ingest-response",
  "type": "object",
  "properties": {
    "accepted": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
      }
    },
    "duplicates": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "eventId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "index",
          "eventId",
          "error"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "accepted",
    "duplicates",
    "rejected"
  ],
  "additionalProperties": false
}
