{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API: ingest-icon",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "itemId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "png": {
          "type": "string",
          "maxLength": 21848,
          "pattern": "^(?=iVBORw0KGgo)(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "required": [
        "itemId",
        "png"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "SKILL"
        },
        "key": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "png": {
          "type": "string",
          "maxLength": 21848,
          "pattern": "^(?=iVBORw0KGgo)(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "required": [
        "kind",
        "key",
        "png"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "BOSS"
        },
        "key": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "png": {
          "type": "string",
          "maxLength": 21848,
          "pattern": "^(?=iVBORw0KGgo)(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "required": [
        "kind",
        "key",
        "png"
      ],
      "additionalProperties": false
    }
  ]
}
