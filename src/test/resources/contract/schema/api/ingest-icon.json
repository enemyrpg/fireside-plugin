{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API: ingest-icon",
  "type": "object",
  "properties": {
    "itemId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "png": {
      "type": "string",
      "maxLength": 21848,
      "pattern": "^(?=iVBORw0KGgo)(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  },
  "required": [
    "itemId",
    "png"
  ],
  "additionalProperties": false
}
