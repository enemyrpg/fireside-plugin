{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API: raid-splits-response",
  "type": "object",
  "properties": {
    "defaults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "mode": {
            "type": "string",
            "enum": [
              "SPLIT",
              "FFA"
            ]
          }
        },
        "required": [
          "accountId",
          "mode"
        ],
        "additionalProperties": false
      }
    },
    "total": {
      "type": "object",
      "properties": {
        "share": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fromOwnDrops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fromTeammateDrops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "share",
        "fromOwnDrops",
        "fromTeammateDrops"
      ],
      "additionalProperties": false
    },
    "raids": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "raid": {
            "type": "string",
            "minLength": 1
          },
          "share": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fromOwnDrops": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fromTeammateDrops": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "manualSpecialLootValue": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "raid",
          "share",
          "fromOwnDrops",
          "fromTeammateDrops",
          "manualSpecialLootValue"
        ],
        "additionalProperties": false
      }
    },
    "months": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "share": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "month",
          "share"
        ],
        "additionalProperties": false
      }
    },
    "drops": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dropId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(\\.(0|[1-9]\\d{0,5}))?$"
              },
              "manual": {
                "type": "boolean"
              },
              "occurredAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
              },
              "accountId": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "sessionId": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "raid": {
                "type": "string",
                "minLength": 1
              },
              "raidGroup": {
                "type": "string",
                "minLength": 1
              },
              "itemId": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "quantity": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "gePriceEach": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "geValue": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "gePriceSource": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "DROP",
                      "SPECIAL_LOOT",
                      "LOOT",
                      "BANK"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "gePriceAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ownValue": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "value": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "valueUnknown": {
                "type": "boolean"
              },
              "recipient": {
                "type": "string",
                "enum": [
                  "SELF",
                  "TEAMMATE"
                ]
              },
              "mode": {
                "type": "string",
                "enum": [
                  "SPLIT",
                  "FFA"
                ]
              },
              "overridden": {
                "type": "boolean"
              },
              "teamSize": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "partySize": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "partySizeOverridden": {
                "type": "boolean"
              },
              "partySizeUnknown": {
                "type": "boolean"
              },
              "share": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "nickname": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "note": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "killCount": {
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "possibleDuplicate": {
                "type": "boolean"
              },
              "duplicateOfDropId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(\\.(0|[1-9]\\d{0,5}))?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "dropId",
              "manual",
              "occurredAt",
              "accountId",
              "sessionId",
              "raid",
              "raidGroup",
              "itemId",
              "name",
              "quantity",
              "gePriceEach",
              "geValue",
              "gePriceSource",
              "gePriceAt",
              "ownValue",
              "value",
              "valueUnknown",
              "recipient",
              "mode",
              "overridden",
              "teamSize",
              "partySize",
              "partySizeOverridden",
              "partySizeUnknown",
              "share",
              "nickname",
              "note",
              "killCount",
              "possibleDuplicate",
              "duplicateOfDropId"
            ],
            "additionalProperties": false
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "nextCursor"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "defaults",
    "total",
    "raids",
    "months",
    "drops"
  ],
  "additionalProperties": false
}
