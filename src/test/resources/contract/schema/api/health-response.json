{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API: health-response",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "const": "ok"
    },
    "serverVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "timeZone": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "status",
    "serverVersion",
    "contractVersion",
    "timeZone"
  ],
  "additionalProperties": false
}
