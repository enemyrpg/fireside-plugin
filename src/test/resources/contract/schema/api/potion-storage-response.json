{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API: potion-storage-response",
  "type": "object",
  "properties": {
    "storages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "takenAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
          },
          "totals": {
            "type": "object",
            "properties": {
              "geValue": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "haValue": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "geValue",
              "haValue"
            ],
            "additionalProperties": false
          },
          "potions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "position": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "itemId": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "doses": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "itemDoses": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4
                },
                "gePriceEach": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "haPriceEach": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "geValue": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "haValue": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "position",
                "itemId",
                "name",
                "doses",
                "itemDoses",
                "gePriceEach",
                "haPriceEach",
                "geValue",
                "haValue"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "accountId",
          "takenAt",
          "totals",
          "potions"
        ],
        "additionalProperties": false
      }
    },
    "totals": {
      "type": "object",
      "properties": {
        "geValue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "haValue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "geValue",
        "haValue"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "storages",
    "totals"
  ],
  "additionalProperties": false
}
