{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API: bank-summary-response",
  "type": "object",
  "properties": {
    "geValue": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bankGeValue": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "potionStorageGeValue": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "inventoryGeValue": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "equipmentGeValue": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cashValue": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "updatedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "prices": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "SNAPSHOT",
            "CURRENT"
          ]
        },
        "fetchedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "fetchedAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "geValue",
    "bankGeValue",
    "potionStorageGeValue",
    "inventoryGeValue",
    "equipmentGeValue",
    "cashValue",
    "updatedAt",
    "prices"
  ],
  "additionalProperties": false
}
