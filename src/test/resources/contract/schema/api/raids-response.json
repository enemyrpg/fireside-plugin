{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API: raids-response",
  "type": "object",
  "properties": {
    "raids": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "raid": {
            "type": "string",
            "minLength": 1
          },
          "lootCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "lootGeValue": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "specialLootGeValue": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "raid",
          "lootCount",
          "lootGeValue",
          "specialLootGeValue"
        ],
        "additionalProperties": false
      }
    },
    "specialLoot": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "occurredAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
              },
              "accountId": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "sessionId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
              },
              "raid": {
                "type": "string",
                "minLength": 1
              },
              "raidGroup": {
                "type": "string",
                "minLength": 1
              },
              "itemId": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "quantity": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "gePriceEach": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "geValue": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "recipient": {
                "type": "string",
                "enum": [
                  "SELF",
                  "TEAMMATE"
                ]
              },
              "teamSize": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "killCount": {
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "occurredAt",
              "accountId",
              "sessionId",
              "raid",
              "raidGroup",
              "itemId",
              "name",
              "quantity",
              "gePriceEach",
              "geValue",
              "recipient",
              "teamSize",
              "killCount"
            ],
            "additionalProperties": false
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "nextCursor"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "raids",
    "specialLoot"
  ],
  "additionalProperties": false
}
