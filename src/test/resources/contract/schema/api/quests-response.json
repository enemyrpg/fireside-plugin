{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API: quests-response",
  "type": "object",
  "properties": {
    "accountId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "updatedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "questPoints": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "totals": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "finished": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inProgress": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "notStarted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "total",
        "finished",
        "inProgress",
        "notStarted"
      ],
      "additionalProperties": false
    },
    "miniquestTotals": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "finished": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inProgress": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "notStarted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "total",
        "finished",
        "inProgress",
        "notStarted"
      ],
      "additionalProperties": false
    },
    "quests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quest": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "QUEST",
              "MINIQUEST"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "NOT_STARTED",
              "IN_PROGRESS",
              "FINISHED"
            ]
          },
          "finishedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "quest",
          "name",
          "kind",
          "state",
          "finishedAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "accountId",
    "updatedAt",
    "questPoints",
    "totals",
    "miniquestTotals",
    "quests"
  ],
  "additionalProperties": false
}
