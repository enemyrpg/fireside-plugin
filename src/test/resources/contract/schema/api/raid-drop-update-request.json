{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API: raid-drop-update-request",
  "type": "object",
  "properties": {
    "mode": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "SPLIT",
            "FFA"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "ownValue": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "partySize": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "nickname": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
